# Finora — variáveis de ambiente (EXEMPLO)
# Copie para .env.local e preencha com os valores reais.
# NUNCA commite valores reais. NUNCA cole secrets em chats, issues ou logs.
# Este arquivo é versionado: mantenha SOMENTE placeholders vazios aqui.

# ── Supabase ──────────────────────────────────────────────────────────────
# URL do projeto (pública)
SUPABASE_URL=
# Publishable key — segura no browser QUANDO há RLS + policies (formato sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=
# Secret key — SOMENTE backend/servidor/CI; ignora RLS. Nunca no frontend nem commitada (sb_secret_...)
SUPABASE_SECRET_KEY=
# JWKS para validação de tokens (backend/edge)
SUPABASE_JWKS_URL=
# Connection string do Postgres — usada para aplicar migrações (CLI/CI). Credencial de banco.
DATABASE_URL=

# ── Google OAuth (AUTH-001) ───────────────────────────────────────────────
# Configurados no provider do Supabase; aqui apenas para referência/dev local.
GOOGLE_OAUTH_CLIENT_ID=
# Client secret — SOMENTE no Supabase (Auth → Providers → Google). Nunca commitar.
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Stripe (BILL-003, futuro) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
