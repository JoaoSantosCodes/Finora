# Finora — variáveis de ambiente (EXEMPLO)
# Copie para .env.local e preencha. NUNCA commite valores reais.
# NUNCA cole a SECRET KEY em chats, issues ou logs. Se exposta, rotacione no painel.

# URL do projeto Supabase (pública)
SUPABASE_URL=

# Publishable key — segura para uso no browser QUANDO há RLS + policies. (novo formato: sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Secret key — SOMENTE backend/servidor/CI. Acesso privilegiado (ignora RLS).
# NUNCA expor no frontend nem commitar. (novo formato: sb_secret_...)
SUPABASE_SECRET_KEY=

# JWKS para validação de tokens (backend/edge)
SUPABASE_JWKS_URL=

# Connection string do Postgres — usada para aplicar migrações (CLI/CI).
# Não é a secret key da API; é a credencial de banco.
DATABASE_URL=
