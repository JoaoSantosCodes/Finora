# Finora — variáveis de ambiente (EXEMPLO)
# Copie para .env.local e preencha. NUNCA commite valores reais.

# URL do projeto Supabase (público)
SUPABASE_URL=

# Chave anônima — pode ir para o cliente (frontend)
SUPABASE_ANON_KEY=

# Chave service role — SOMENTE backend/servidor. NUNCA expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão do Postgres (uso local/CI de migrações)
DATABASE_URL=
